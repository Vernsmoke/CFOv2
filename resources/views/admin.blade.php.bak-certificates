<!doctype html>
<html lang="en" class="admin-background-root">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#152c40">
  <meta name="description" content="Christian Formation Office registration and attendance management.">
  <title>CFO · Admin Panel</title>
  <style>
    /* 01. Design tokens and foundation */
    :root {
      --ink: #192c3a; --muted: #586c7a; --primary: #146b61; --primary-hover: #0d554d;
      --navy: #152c40; --canvas: #f4f7f9; --surface: #fff; --line: #dce5e9;
      --soft: #edf5f2; --danger: #ab343d; --radius: 14px; --sidebar: 252px;
      --shadow: 0 6px 24px #142f4208;
      font-family: "Segoe UI", Arial, sans-serif; color: var(--ink); font-size: 15px;
      background: var(--canvas); scrollbar-gutter: stable;
    }
    *, *::before, *::after { box-sizing: border-box; }
    body { margin: 0; line-height: 1.55; }
    h1, h2, h3, p { margin: 0; }
    h1 { font-size: clamp(25px, 2.4vw, 34px); line-height: 1.2; letter-spacing: -.9px; font-weight: 650; }
    h2 { font-size: 18px; line-height: 1.4; letter-spacing: -.3px; font-weight: 650; }
    h3 { font-size: 15px; font-weight: 650; }
    a { color: var(--primary); text-underline-offset: 3px; }
    button, input, select, textarea { font: inherit; }
    button, a { -webkit-tap-highlight-color: transparent; touch-action: manipulation; }
    button { cursor: pointer; }
    button:disabled { opacity: .45; cursor: not-allowed; }
    :focus-visible { outline: 3px solid #2785bd; outline-offset: 3px; }
    [hidden] { display: none !important; }
    .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; clip-path: inset(50%); overflow: hidden; white-space: nowrap; }
    .icon { width: 20px; height: 20px; flex: 0 0 20px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
    .muted { color: var(--muted); }
    .small { font-size: 13px; }
    .eyebrow { color: var(--muted); font-size: 11px; font-weight: 700; letter-spacing: 1.7px; text-transform: uppercase; }
    .skip-link { position: fixed; left: 16px; top: -100px; z-index: 100; padding: 10px 16px; background: white; border-radius: 8px; }
    .skip-link:focus { top: 12px; }

    /* 02. Shared navigation and page shell */
    .sidebar { position: fixed; inset: 0 auto 0 0; width: var(--sidebar); background: var(--navy); color: #e5edf3; display: flex; flex-direction: column; z-index: 40; }
    .brand { display: flex; align-items: center; gap: 12px; padding: 27px 22px 22px; text-decoration: none; color: white; }
    .brand img { width: 43px; height: 49px; object-fit: contain; flex: 0 0 43px; }
    .brand strong { display: block; font-family: Georgia, serif; font-size: 21px; font-weight: 500; line-height: 1.2; }
    .brand small { display: block; margin-top: 5px; color: #b9cbd6; font-size: 10px; letter-spacing: 1.15px; text-transform: uppercase; }
    .workspace-label { margin: 0 18px 14px; padding: 11px 12px; border: 1px solid #ffffff20; border-radius: 9px; font-size: 12px; color: #d4e0e8; }
    .sidebar nav { flex: 1; overflow-y: auto; padding: 0 12px 16px; }
    .nav-group { font-size: 10px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: #a7bbc9; padding: 18px 13px 7px; }
    .nav-link { display: flex; align-items: center; gap: 12px; padding: 10px 13px; min-height: 43px; margin: 2px 0; color: #d7e2ea; text-decoration: none; font-size: 13px; border-radius: 8px; line-height: 1.4; }
    .nav-link:hover { background: #ffffff0d; color: white; }
    .nav-link.active { color: white; background: #ffffff15; box-shadow: inset 3px 0 #6dc8ad; font-weight: 650; }
    .sidebar-footer { flex-shrink: 0; border-top: 1px solid #ffffff18; padding: 14px 18px; display: grid; grid-template-columns: 34px 1fr auto; gap: 10px; align-items: center; }
    .avatar { display: inline-grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: #e4edea; color: #28574e; font-size: 12px; font-weight: 700; flex-shrink: 0; }
    .sidebar-footer strong { font-size: 12px; display: block; }
    .sidebar-footer small { color: #b0c4d1; font-size: 11px; }
    .sidebar-footer button { background: none; border: 0; color: #d6e3ec; width: 38px; height: 40px; border-radius: 6px; }
    .sidebar-footer button:hover { background: #ffffff12; }
    .shell { margin-left: var(--sidebar); min-width: 0; }
    .topbar { width: calc(100% - 32px); max-width: 1620px; min-height: 70px; display: flex; align-items: center; gap: 12px; margin: 16px auto 0; padding: 12px 20px; background: #ffffffed; border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); }
    .topbar-title { min-width: 0; font-size: 13px; color: var(--muted); flex: 1; }
    .topbar-actions { display: flex; align-items: center; gap: 12px; }
    .topbar-actions .account { display: flex; align-items: center; gap: 9px; border: 0; background: transparent; padding: 4px; text-align: left; color: var(--ink); }
    .account strong { display: block; font-size: 12px; }
    .account small { display: block; color: var(--muted); font-size: 11px; }
    .preview-tag { display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--line); background: #f8fafb; color: var(--muted); padding: 4px 9px; border-radius: 6px; font-size: 11px; font-weight: 600; white-space: nowrap; }
    .preview-tag::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: #688778; }
    .preview-tag.live { color: #176344; border-color: #b8dccb; background: #f0faf4; }
    .preview-tag.live::before { background: #16a15c; box-shadow: 0 0 0 3px #16a15c22; }
    .topbar #live-status { border-radius: 999px; }
    .data-table tr.live-highlight { animation: live-row-highlight 3s ease-out; }
    @keyframes live-row-highlight { 0%,45% { background: #fff0bf; } 100% { background: transparent; } }
    main { max-width: 1620px; margin: auto; padding: 30px 32px 42px; min-width: 0; }
    .page-heading { display: flex; gap: 20px; justify-content: space-between; align-items: flex-end; margin-bottom: 26px; }
    .page-heading .eyebrow { margin-bottom: 9px; }
    .page-heading p { color: var(--muted); font-size: 14px; margin-top: 9px; max-width: 740px; }
    #page-title:focus, #history-heading:focus { outline: none; }
    .page-actions, .actions { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .page-actions { flex-shrink: 0; }
    .page-foot { display: flex; justify-content: space-between; gap: 12px; margin-top: 28px; border-top: 1px solid var(--line); padding-top: 16px; color: var(--muted); font-size: 11px; }
    .icon-btn.nav-close { display: none; }
    .nav-backdrop { position: fixed; inset: 0; background: #11273780; z-index: 35; border: 0; }
    body.nav-collapsed .sidebar { display: none; }
    body.nav-collapsed .shell { margin-left: 0; }

    /* 03. Buttons, badges, forms and feedback */
    .btn { min-height: 40px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 9px 14px; border: 1px solid #bccbd3; border-radius: 8px; color: #294552; background: white; font-size: 13px; line-height: 1.4; font-weight: 600; text-decoration: none; }
    .btn:hover:not(:disabled) { background: #f1f6f7; border-color: #8fa6b2; }
    .btn.primary { background: var(--primary); border-color: var(--primary); color: white; }
    .btn.primary:hover:not(:disabled) { background: var(--primary-hover); border-color: var(--primary-hover); }
    .btn.danger { color: var(--danger); border-color: #d5aab0; background: white; }
    .btn.danger:hover { background: #fff1f2; }
    .btn.quiet { border-color: transparent; background: transparent; }
    .btn.compact { padding: 6px 10px; min-height: 34px; font-size: 12px; }
    .icon-btn { display: inline-grid; place-items: center; width: 40px; height: 40px; min-width: 40px; border: 1px solid var(--line); border-radius: 8px; background: white; color: #365360; }
    .icon-btn:hover { background: #edf4f6; }
    .badge { display: inline-flex; align-items: center; gap: 6px; padding: 4px 9px; background: #eef2f5; color: #49606f; border-radius: 5px; font-size: 11px; font-weight: 650; line-height: 1.5; }
    .badge::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: currentColor; flex-shrink: 0; }
    .badge.success { color: #21694c; background: #e9f4ee; }
    .badge.warning { color: #8a601d; background: #fbf1de; }
    .badge.danger { color: #a63d48; background: #fbecef; }
    .badge.info { color: #326589; background: #eaf2fa; }
    label.field { display: grid; gap: 7px; font-size: 12px; font-weight: 650; color: #354d5a; min-width: 0; }
    input:not([type=checkbox]), select, textarea { width: 100%; min-width: 0; border: 1px solid #bdcbd4; border-radius: 7px; padding: 10px 12px; min-height: 42px; color: var(--ink); background: white; font-size: 13px; }
    input::placeholder, textarea::placeholder { color: #748592; }
    input[readonly] { background: #f4f7f9; color: #586e7c; }
    textarea { min-height: 100px; resize: vertical; }
    input[type=checkbox] { width: 17px; height: 17px; accent-color: var(--primary); cursor: pointer; vertical-align: middle; }
    .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
    .form-grid .full { grid-column: 1 / -1; }
    .form-section + .form-section { border-top: 1px solid var(--line); margin-top: 26px; padding-top: 24px; }
    .form-section h3 { margin-bottom: 16px; }
    .form-actions { display: flex; gap: 10px; justify-content: flex-end; flex-wrap: wrap; padding-top: 22px; margin-top: 22px; border-top: 1px solid var(--line); }
    .check-label { display: flex; align-items: center; gap: 10px; font-size: 13px; }
    .notice { padding: 13px 16px; border: 1px solid #d3e6df; border-radius: 9px; background: #f0f7f4; color: #3e6359; font-size: 12px; line-height: 1.6; margin-bottom: 20px; }
    .notice.neutral { background: #f6f8fa; border-color: var(--line); color: var(--muted); }
    .form-help { font-size: 12px; color: var(--muted); font-weight: 400; }
    .toast { position: fixed; bottom: 22px; left: 50%; transform: translateX(-50%); z-index: 70; max-width: calc(100vw - 32px); width: max-content; background: var(--navy); color: white; padding: 12px 20px; border-radius: 9px; box-shadow: var(--shadow); font-size: 13px; }

    /* 04. Cards, dashboard and information panels */
    .panel { min-width: 0; border: 1px solid var(--line); background: white; border-radius: var(--radius); box-shadow: var(--shadow); overflow: clip; }
    .panel-body { padding: 24px; }
    .panel-head { display: flex; gap: 16px; justify-content: space-between; align-items: center; padding: 21px 24px; border-bottom: 1px solid var(--line); }
    .panel-head p { margin-top: 4px; color: var(--muted); font-size: 12px; }
    .stack { display: grid; grid-template-columns: minmax(0,1fr); gap: 22px; min-width: 0; }
    #grid-host, #page { min-width: 0; }
    .split { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 22px; align-items: start; }
    .dashboard-split { grid-template-columns: minmax(0, 1fr) 310px; }
    .metrics { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
    .metric { padding: 21px 22px 18px; border: 1px solid var(--line); border-radius: 12px; background: white; min-width: 0; box-shadow: var(--shadow); }
    .metric-top { display: flex; gap: 8px; align-items: center; justify-content: space-between; font-size: 12px; color: #506775; font-weight: 600; }
    .metric-icon { display: grid; place-items: center; width: 33px; height: 33px; color: var(--primary); background: #eef5f2; border-radius: 9px; flex-shrink: 0; }
    .metric strong { display: block; font-size: 32px; letter-spacing: -1px; font-weight: 650; margin: 10px 0 6px; line-height: 1.1; font-variant-numeric: tabular-nums; }
    .metric a, .metric p { display: flex; align-items: center; gap: 5px; margin-top: 11px; font-size: 11px; text-decoration: none; }
    .metric a:hover { text-decoration: underline; }
    .metric a .icon { width: 13px; height: 13px; flex-basis: 13px; }
    .welcome { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 24px; border-radius: 12px; background: #e9f2ef; border: 1px solid #d8e7e1; }
    .welcome p { font-size: 13px; color: #48685e; margin-top: 6px; }
    .welcome .icon { width: 20px; height: 20px; flex-basis: 20px; }
    .task-link { display: flex; gap: 12px; align-items: center; padding: 17px 0; color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--line); }
    .task-link:last-child { border-bottom: 0; padding-bottom: 0; }
    .task-link:first-child { padding-top: 0; }
    .task-link strong { display: block; font-size: 13px; }
    .task-link small { display: block; color: var(--muted); font-size: 12px; margin-top: 3px; }
    .task-link > .icon:last-child { margin-left: auto; width: 16px; height: 16px; }
    .event-date { display: inline-grid; place-items: center; padding: 10px 17px; border: 1px solid #dae8e1; border-radius: 10px; background: #edf5f1; color: #2f6b56; margin-bottom: 18px; }
    .event-date small { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; }
    .event-date strong { font-size: 28px; font-weight: 600; line-height: 1.3; }
    .detail-list { display: grid; grid-template-columns: 130px minmax(0,1fr); gap: 14px 20px; font-size: 13px; margin: 0; }
    .detail-list dt { color: var(--muted); }
    .detail-list dd { margin: 0; overflow-wrap: anywhere; font-weight: 500; }
    .detail-list.vertical { grid-template-columns: 1fr; gap: 4px; }
    .detail-list.vertical dd { margin-bottom: 13px; }
    .group-list { display: grid; gap: 12px; }
    .group-row { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 20px; border: 1px solid var(--line); border-radius: 10px; background: white; }
    .group-title { display: flex; align-items: center; gap: 14px; }
    .group-mark { padding: 10px; min-width: 58px; background: var(--soft); color: var(--primary); border-radius: 9px; font-size: 12px; font-weight: 700; text-align: center; }
    .empty { text-align: center; padding: 48px 22px; }
    .empty .icon { width: 32px; height: 32px; margin-bottom: 12px; color: #668794; }
    .empty p { max-width: 470px; margin: 8px auto 18px; color: var(--muted); font-size: 13px; }

    /* 05. Reusable data grids */
    .filters { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 14px; padding: 20px 24px; border-bottom: 1px solid var(--line); }
    .filters .field { flex: 1 1 140px; }
    .filters .field.search { flex: 2 1 230px; }
    .table-toolbar { display: flex; justify-content: space-between; gap: 14px; align-items: center; flex-wrap: wrap; padding: 15px 24px; border-bottom: 1px solid var(--line); background: #fcfdfd; }
    .table-wrap { overflow-x: auto; max-width: 100%; }
    table { width: 100%; border-collapse: collapse; font-size: 12px; text-align: left; }
    th { padding: 13px 18px; background: #f7f9fb; color: #5a6f7d; font-size: 10px; letter-spacing: .55px; text-transform: uppercase; white-space: nowrap; font-weight: 650; border-bottom: 1px solid var(--line); }
    td { padding: 16px 18px; border-bottom: 1px solid #eaf0f3; vertical-align: middle; line-height: 1.5; }
    tbody tr:last-child td { border-bottom: 0; }
    tbody tr:hover { background: #fafcfd; }
    .data-table { min-width: 780px; }
    #page:has(.welcome) .data-table { min-width: 620px; }
    .data-table.wide { min-width: 1080px; }
    .data-table td { max-width: 320px; }
    .data-table .actions { flex-wrap: nowrap; }
    .data-table input[type=checkbox] { margin: 0; }
    @media screen and (min-width: 1001px) {
      #data-grid.history-grid .data-table { min-width: 0; width: 100%; table-layout: fixed; }
      #data-grid.history-grid .data-table :is(th, td) { padding-inline: 8px; white-space: normal; overflow-wrap: anywhere; }
      #data-grid.history-grid .grid-sort { display: block; max-width: 100%; white-space: normal; }
      #data-grid.history-grid th:nth-child(1) { width: 16%; }
      #data-grid.history-grid th:nth-child(2) { width: 13%; }
      #data-grid.history-grid th:nth-child(3) { width: 17%; }
      #data-grid.history-grid th:nth-child(4) { width: 12%; }
      #data-grid.history-grid th:nth-child(5) { width: 15%; }
      #data-grid.history-grid th:nth-child(6) { width: 15%; }
      #data-grid.history-grid th:nth-child(7) { width: 12%; }
    }
    .data-table select { min-width: 148px; min-height: 36px; padding: 6px 9px; font-size: 12px; }
    .name-cell strong { display: block; font-weight: 650; white-space: nowrap; }
    .name-cell span { display: block; color: var(--muted); font-size: 11px; margin-top: 3px; }
    .nowrap { white-space: nowrap; }
    .table-footer { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; justify-content: space-between; padding: 16px 24px; border-top: 1px solid var(--line); color: var(--muted); font-size: 12px; }
    .pagination { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
    .pagination select { width: 65px; min-height: 34px; font-size: 12px; padding: 5px 8px; }
    .table-empty { padding: 40px; text-align: center; color: var(--muted); }
    .tabs { display: flex; gap: 8px; border-bottom: 1px solid var(--line); margin-bottom: 24px; overflow-x: auto; }
    .tab { padding: 12px 16px; border: 0; border-bottom: 2px solid transparent; background: transparent; color: var(--muted); font-size: 13px; white-space: nowrap; }
    .tab.active { color: var(--primary); border-bottom-color: var(--primary); font-weight: 650; }

    /* Password reset queue */
    .recovery-overview { display: grid; gap: 20px; margin-bottom: 20px; }
    .recovery-office { display: flex; align-items: flex-start; gap: 14px; padding: 20px 24px; background: var(--soft); border: 1px solid #cce1d7; border-radius: 12px; }
    .recovery-office > .icon { color: var(--primary); margin-top: 3px; }
    .recovery-office p { color: #48685e; font-size: 13px; margin-top: 5px; max-width: 850px; }
    .recovery-tabs { display: flex; gap: 8px; flex-wrap: wrap; }
    .recovery-tabs .btn[aria-pressed=true] { background: var(--navy); color: white; border-color: var(--navy); }
    .recovery-grid .name-cell strong { white-space: normal; }
    .recovery-grid .name-cell span { overflow-wrap: anywhere; }
    .recovery-grid .data-table .actions { flex-wrap: wrap; min-width: 150px; }
    .recovery-grid .data-table .actions .btn { min-height: 38px; }
    .recovery-status-help { display: block; color: var(--muted); font-size: 11px; margin-top: 6px; max-width: 170px; }
    .recovery-review-card { padding: 18px; border: 1px solid var(--line); background: #f8fafb; border-radius: 10px; margin-bottom: 20px; }
    .recovery-confirm { padding: 16px; border: 1px solid #cce1d7; border-radius: 9px; background: var(--soft); align-items: flex-start; }
    .recovery-confirm input { flex-shrink: 0; margin-top: 3px; }
    .recovery-error { color: var(--danger); font-size: 13px; margin-top: 14px; }

    /* 06. Dialogs and print previews */
    dialog { width: min(570px, calc(100vw - 32px)); padding: 0; margin: auto; border: 1px solid var(--line); border-radius: 15px; color: var(--ink); max-height: calc(100dvh - 32px); overflow-y: auto; box-shadow: 0 24px 100px #091e3b25; }
    dialog.large { width: min(850px, calc(100vw - 32px)); }
    dialog::backdrop { background: #10293e80; backdrop-filter: blur(2px); }
    body:has(dialog[open]) { overflow: hidden; }
    .dialog-header { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 20px 24px; border-bottom: 1px solid var(--line); }
    .dialog-body { padding: 24px; }
    .dialog-body > p { color: var(--muted); font-size: 14px; margin-bottom: 18px; }
    .dialog-body .notice:last-child { margin-bottom: 0; }
    .dialog-footer:empty { display: none; }
    .dialog-footer { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 10px; padding: 18px 24px; border-top: 1px solid var(--line); background: #fbfcfd; }
    .certificate { background: #fdfdfb; border: 1px solid #cbbd8e; outline: 5px solid #f5f2e8; padding: 32px 24px; text-align: center; color: #285346; margin: 5px; overflow-wrap: anywhere; }
    .certificate .school { font-size: 10px; letter-spacing: 1.4px; text-transform: uppercase; }
    .certificate h2 { font: 600 25px/1.4 Georgia,serif; letter-spacing: 2px; margin: 27px 0 18px; }
    .certificate .recipient { font: italic 30px/1.4 Georgia,serif; border-bottom: 1px solid #d5d9ce; padding-bottom: 14px; margin: 18px auto; max-width: 90%; }
    .certificate p { font-size: 12px; line-height: 1.8; }
    .certificate .signature { margin-top: 30px; font-size: 11px; }
    .poster { display: grid; place-content: center; min-height: 280px; padding: 32px; background: #eff2e7; color: #435b43; text-align: center; border: 1px solid #dbe2cc; border-radius: 9px; }
    .poster strong { font: 38px/1.15 Georgia,serif; margin: 18px 0; }
    .poster small { font-size: 10px; letter-spacing: 2px; text-transform: uppercase; }
    .print-area { display: none; }
    .signed-out { max-width: 440px; margin: 10vh auto; text-align: center; }
    @media print {
      body > * { display: none !important; }
      body > .print-area { display: block !important; }
      .print-area { padding: 12mm; color: black; background: white; }
      .print-area h1 { font-size: 23px; margin-bottom: 8px; }
      .print-area p { font-size: 12px; margin-bottom: 18px; }
      .print-area table { min-width: 0; font-size: 10px; }
      .print-area th,.print-area td { padding: 8px; }
      .certificate { break-inside: avoid; }
    }

    /* 07. Responsive layout and reduced motion */
    @media (min-width: 1600px) { main { padding: 36px 46px; } }
    @media (max-width: 1200px) {
      .split { grid-template-columns: minmax(0,1fr); }
      .dashboard-side { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 20px; }
      .metrics { grid-template-columns: repeat(2,minmax(0,1fr)); }
    }
    @media (max-width: 1000px) {
      .sidebar { transform: translateX(-100%); width: min(285px,calc(100vw - 40px)); }
      body.nav-open .sidebar { transform: translateX(0); }
      body.nav-collapsed .sidebar { display: flex; }
      .shell { margin-left: 0; }
