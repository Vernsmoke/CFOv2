APP_NAME="CFO Registration and Attendance Monitoring System"
APP_ENV=production
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_URL=https://example.com
# January 1 archive cutoff uses this server timezone, including live year rollover.
APP_TIMEZONE=Asia/Manila

# Optional student QR origin; blank uses APP_URL.
CFO_ACCESS_URL=
# Comma-separated IP addresses/CIDRs of your deployment reverse proxies only.
TRUSTED_PROXIES=
# Choose sse, or polling when your deployment proxy buffers event streams.
CFO_LIVE_TRANSPORT=sse

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=db.example.com
DB_PORT=3306
DB_DATABASE=cfov2
# Use a dedicated database account and supply its password at deployment.
DB_USERNAME=cfo_app
DB_PASSWORD=
DB_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
FILESYSTEM_UPLOAD_DISK=local
QUEUE_CONNECTION=database

# Set these explicitly before the optional first-admin seed. No default login.
CFO_DEFAULT_ADMIN_EMAIL=
CFO_DEFAULT_ADMIN_PASSWORD=
# Local demonstrations only. DatabaseSeeder refuses these accounts in production.
CFO_DEMO_ACCOUNTS_ENABLED=false
CFO_DEMO_ACCOUNTS_PASSWORD=ChangeMe123!

CACHE_DRIVER=database
CACHE_STORE="${CACHE_DRIVER}"
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_TABLE=cache_locks
# CACHE_PREFIX=

MEMCACHED_HOST=memcached.example.com

REDIS_CLIENT=phpredis
REDIS_HOST=redis.example.com
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_PORT=6379

# Configure SMTP delivery for application email.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
